:root {
  font-family:
    Inter,
    ui-sans-serif,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;

  color: #172a42;
  background: #f4f8fc;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
}

* {
  box-sizing: border-box;
}

html,
body,
#root {
  margin: 0;
  min-width: 320px;
  min-height: 100vh;
}

body {
  background:
    linear-gradient(
      135deg,
      #f8fbff 0%,
      #f1f6fb 100%
    );
}

button,
input,
select {
  font: inherit;
}
